# Hostinger Node.js / Passenger process limits (prevents hitting Hostinger max process NPROC limit)
<IfModule lsapi_module>
    PassengerMinInstances 1
    PassengerMaxInstances 1
</IfModule>
<IfModule mod_passenger.c>
    PassengerMinInstances 1
    PassengerMaxInstances 1
    PassengerPoolIdleTime 0
</IfModule>

DirectoryIndex server.js app.js index.js

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not redirect CORS OPTIONS preflight requests to avoid browser CORS preflight redirect errors
    RewriteCond %{HTTPS} off
    RewriteCond %{REQUEST_METHOD} !OPTIONS
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pass all incoming requests to server.js
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ server.js/$1 [QSA,L]
</IfModule>
