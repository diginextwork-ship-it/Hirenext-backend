# Hostinger Node.js / Passenger configuration
DirectoryIndex server.js

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not redirect CORS OPTIONS preflight requests to avoid browser CORS preflight redirect errors
    RewriteCond %{HTTPS} off
    RewriteCond %{REQUEST_METHOD} !OPTIONS
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pass all incoming requests to server.js
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ server.js/$1 [QSA,L]
</IfModule>
